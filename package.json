{
  "name": "workflow-repo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "npx live-server -c-1 . -p 5500",
    "dev": "npx tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "format": "npx prettier . --write",
    "lint": "npx eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "prepare": "husky install",
    "test:vitest": "npx vitest",
    "test:e2e": "npx playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "live-server": "^1.2.2",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.12",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.html": [
      "prettier --write"
    ]
  }
}
